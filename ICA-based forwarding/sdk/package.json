{
  "name": "@celestia-ica/forwarding-sdk",
  "version": "0.1.0",
  "description": "SDK for ICA-based token forwarding through Celestia",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "forward:compute": "ts-node src/cli/compute-address.ts",
